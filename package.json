{
  "name": "awdoc",
  "productName": "awDOC",
  "desktopName": "awdoc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "awDOC — kelime işlemci uygulaması",
  "author": "mADEMatik <ademvarol@madematik.com>",
  "license": "MIT",
  "homepage": "https://www.madematik.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/200709078/awDOC.git"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "deploy": "npm run build && node scripts/deploy-ftp.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && node scripts/dev-electron.mjs",
    "electron": "npm run build && node scripts/start-electron.mjs",
    "test": "playwright test",
    "test:electron": "npm run build && node scripts/test-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "build": {
    "appId": "com.madematik.awdoc",
    "productName": "awDOC",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "awd",
        "name": "awDOC.Document",
        "description": "awDOC belgesi",
        "mimeType": "application/x-awdoc",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office;WordProcessor;Education",
      "executableName": "awdoc",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "awDOC",
          "Comment": "Kelime işlemci"
        }
      }
    },
    "deb": {
      "packageCategory": "education"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "awDOC"
    }
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "fflate": "0.8.2",
    "mathlive": "0.111.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "basic-ftp": "^6.2.3",
    "dotenv": "^17.4.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
